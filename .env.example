# Obrigatório para o ciclo operacional (API e CLI).
MLFLOW_TRACKING_URI=http://localhost:5010
MLFLOW_EXPERIMENT_NAME=projeto-integrador

# Artifact store (MinIO).
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=user
AWS_SECRET_ACCESS_KEY=password
AWS_DEFAULT_REGION=us-east-1

# Registry: train → dev.* @ candidate; promote → prod.* @ champion.
PROJETO_MLOPS_DEV_MODEL=dev.churn-pipeline
PROJETO_MLOPS_PROD_MODEL=prod.churn-pipeline

# Extração: token em https://www.kaggle.com/settings
KAGGLE_USERNAME=
KAGGLE_KEY=
