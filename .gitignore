# Ambiente virtual
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/

# Jupyter
.ipynb_checkpoints/

# Dados e modelos (artefatos locais; pastas vazias ficam via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/interm/*
!data/interm/.gitkeep
data/processed/*
!data/processed/.gitkeep
models/*
!models/.gitkeep

# LaTeX (artefatos de compilação)
*.aux
*.bbl
*.blg
*.log
*.out
*.synctex.gz
*.toc
*.fls
*.fdb_latexmk

# Credenciais (Kaggle, etc.)
.env
.kaggle/
kaggle.json

# Contexto local do projeto (não versionar)
PROJECT_CONTEXT.md

# MLOps / experimentos
mlruns/
mlartifacts/
.pytest_cache/
.mlflow/

# SO / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Apoio local (enunciado, template SBC de exemplo, scripts antigos)
article/modelo artigo/
article/*.docx
article/artigo/_gerar_pptx.py
extrai_figuras.py

# Figuras do artigo: só as citadas no article.tex (os notebooks geram as demais)
article/artigo/figuras/*
!article/artigo/figuras/eda_contrato.png
!article/artigo/figuras/avaliacao_modelo.png
!article/artigo/figuras/shap_beeswarm.png
!article/artigo/figuras/selecao_k.png

# Apresentação: versiona só o PDF final
apresentacao/*
!apresentacao/*.pdf
